    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "admin:hash": "node scripts/admin-hash.mjs",
    "seed:glossary": "node --env-file-if-exists=.env.local scripts/seed-glossary.mjs",
