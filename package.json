    "seed:consulting": "node --env-file-if-exists=.env.local scripts/seed-consulting.mjs",
    "seed:all": "npm run seed:glossary && npm run seed:insights && npm run seed:consulting && npm run seed:kb",
    "mail:test": "node --env-file-if-exists=.env.local scripts/test-mail.mjs",
    "seed:kb": "node --env-file-if-exists=.env.local scripts/seed-kb.mjs",
